{
  "name": "quiz-2-backend",
  "version": "1.0.0",
  "description": "Backend API para Gestión de Inventarios - Constructora (Quiz 2)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:sync": "node src/config/syncDb.js",
    "lint:backend": "node ../.agents/skills/backend-postgres-guardian/scripts/lint-backend.js ."
  },
  "keywords": [
    "express",
    "sequelize",
    "postgresql",
    "inventarios"
  ],
  "author": "Integrante 2",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
